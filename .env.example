# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (same project as the TPPG Portal)
# Use the ANON key only. It must be limited by RLS / public views.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: used by /api/inquiries to insert leads. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Map tiles (optional). Defaults: OpenStreetMap (street) and Esri World Imagery (satellite),
# which are fine for development. For production traffic, use a provider key, e.g. MapTiler:
#   https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
#   https://api.maptiler.com/maps/satellite/{z}/{x}/{y}.jpg?key=YOUR_KEY
NEXT_PUBLIC_MAP_STREET_URL=
NEXT_PUBLIC_MAP_STREET_ATTRIBUTION=
NEXT_PUBLIC_MAP_SATELLITE_URL=
NEXT_PUBLIC_MAP_SATELLITE_ATTRIBUTION=
NEXT_PUBLIC_MAP_LABELS_URL=

# TPPG Portal URL (footer "Agent Login" link)
NEXT_PUBLIC_PORTAL_URL=
